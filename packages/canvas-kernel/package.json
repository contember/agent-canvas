{
  "name": "@fabrika/canvas-kernel",
  "version": "0.1.0",
  "type": "module",
  "description": "Host-agnostic canvas engine: JSX→Bun.build compiler, session/revision store, JSX watcher, WebSocket feedback protocol, and the component library + annotation runtime.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/contember/agent-canvas",
    "directory": "packages/canvas-kernel"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./server": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./components": {
      "types": "./src/client/components/index.ts",
      "default": "./src/client/components/index.ts"
    },
    "./runtime": {
      "types": "./src/client/runtime.ts",
      "default": "./src/client/runtime.ts"
    },
    "./client/*": "./src/client/*",
    "./engine/*": "./src/engine/*",
    "./styles.css": "./src/client/styles.css",
    "./theme.css": "./src/client/theme.css"
  },
  "imports": {
    "#canvas/components": "./src/client/components/index.ts",
    "#canvas/runtime": "./src/client/runtime.ts"
  },
  "dependencies": {
    "marked": "^17.0.4",
    "mermaid-parser-bundle": "^0.1.2",
    "preact": "^10.25.0",
    "preact-render-to-string": "^6.6.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
