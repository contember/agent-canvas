{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Match the strictest consumer. The kernel ships as sources, so a flag a
    // host sets is a flag the kernel's own files are checked under.
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["@types/bun"],
    "paths": {
      "#canvas/runtime": ["./src/client/runtime.ts"],
      "#canvas/components": ["./src/client/components/index.ts"]
    }
  },
  "include": ["index.ts", "src/**/*"],
  "exclude": [
    "src/client/preact-all.ts"
  ]
}
